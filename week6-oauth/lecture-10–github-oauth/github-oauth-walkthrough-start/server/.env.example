PORT=3000

# GitHub: Settings → Developer settings → OAuth Apps → New OAuth App
#   Homepage URL: http://localhost:5173
#   Redirect URI: http://localhost:5173/api/auth/github/callback (must match GITHUB_CALLBACK_URL exactly)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:5173/api/auth/github/callback

# The repo where "Report a problem" creates issues: owner/repo
GITHUB_REPO=

# The SHOP'S own token for the issues – not the admin's.
# GitHub: Settings → Developer settings → Personal access tokens → Fine-grained tokens → Generate new token
#   Expiration: e.g. 90 days · Repository access: Only select repositories → GITHUB_REPO
#   Permissions → Repository permissions → Issues: Read and write
# The issues get this account as the author – e.g. a separate GitHub account for the shop.
GITHUB_ISSUES_TOKEN=

# GitHub usernames that are admins, exactly as on GitHub, comma-separated without spaces, e.g. anna-k,erik99
# OBS, make sure to add "sibala" to the allowed admins list
ADMIN_GITHUB_LOGINS=sibala,user1,user2

# The shop's own login cookie (a JWT, as in L8's jwt-walkthrough).
# Create it with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_TOKEN_SECRET=
