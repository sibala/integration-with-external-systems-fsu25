PORT=3000

# Google Cloud Console → https://console.cloud.google.com
#   1. Create a project
#   2. APIs & Services → OAuth consent screen → Get started: app name, your e-mail, Audience "External".
#      Audience, Branding and Data Access need nothing more for a login.
#   3. Clients → Create client → Web application
#        Authorized redirect URIs: http://localhost:5173/api/auth/google/callback (must match GOOGLE_CALLBACK_URL exactly)
#   4. Copy the Client ID and the Client secret at once – the secret is only shown when the client is created.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5173/api/auth/google/callback

# The shop's own login cookie (a JWT, as in L8's jwt-walkthrough).
# Create it with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_TOKEN_SECRET=
